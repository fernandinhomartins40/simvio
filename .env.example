# Simvio — variáveis de ambiente. Copie para .env e preencha. NUNCA versione o .env.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Nome do projeto Compose (isola containers, redes e volumes de outras aplicações da VPS)
COMPOSE_PROJECT_NAME=simvio

# Única porta publicada no host (Nginx da Simvio). Com proxy central na VPS, publique só em 127.0.0.1.
SIMVIO_PORT=8080
SIMVIO_BIND_ADDRESS=127.0.0.1
# Origens cujo X-Forwarded-For o Nginx da Simvio aceita (proxy central chegando pela ponte do Docker).
SIMVIO_TRUSTED_PROXIES=172.16.0.0/12

# Origem pública HTTPS, sem barra final. A API fica em ${PUBLIC_BASE_URL}/api/v1
PUBLIC_BASE_URL=https://simvio.exemplo.com.br

# PostgreSQL (rede privada do Compose; porta 5432 não é publicada)
POSTGRES_USER=simvio
# Use só letras e números (vai dentro da DATABASE_URL). Ex.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
POSTGRES_DB=simvio

# Chaves AES-256-GCM: "id:base64(32 bytes)". A primeira cifra; as demais só decifram (rotação).
# Ex.: SIMVIO_ENCRYPTION_KEYS=k2:<nova>,k1:<antiga>
SIMVIO_ENCRYPTION_KEYS=k1:
# HMAC para digests de telefone (base64, 32 bytes). Não rotacionar sem migrar os digests.
SIMVIO_HMAC_KEY=

# Prazos (segundos)
VERIFICATION_TTL_SECONDS=300
PAIRING_TTL_SECONDS=300
LINE_CHECK_TTL_SECONDS=900
DEVICE_DEGRADED_AFTER_SECONDS=1200
DEVICE_OFFLINE_AFTER_SECONDS=3600

# E-mail transacional (confirmação/recuperação). Provedor real em produção.
SMTP_URL=
MAIL_FROM=Simvio <nao-responda@simvio.exemplo.com.br>

# Somente desenvolvimento isolado. Proibido em produção (a API recusa iniciar).
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

LOG_LEVEL=info
