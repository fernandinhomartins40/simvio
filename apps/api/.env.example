# Desenvolvimento local da API/worker (fora de containers). Copie para .env.
# Gere cada chave: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development
DATABASE_URL=postgresql://simvio:simvio_dev_only@127.0.0.1:15432/simvio?schema=public
API_PORT=3101
PUBLIC_BASE_URL=http://localhost:5174
SIMVIO_ENCRYPTION_KEYS=k1:
SIMVIO_HMAC_KEY=
# Somente dev isolado: permite webhook para http://127.0.0.1 (exemplo local)
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
SMTP_URL=smtp://127.0.0.1:1025
LOG_LEVEL=info
